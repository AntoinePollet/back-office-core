{
  "name": "back-office",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter playground build",
    "db:generate": "pnpm --filter backoffice-core db:generate",
    "db:migrate": "pnpm --filter playground db:migrate",
    "typecheck": "pnpm --filter playground typecheck",
    "test:unit": "pnpm --filter backoffice-core test && pnpm --filter create-site test",
    "test:e2e": "node tests/run.mjs",
    "test": "pnpm test:unit && pnpm typecheck && pnpm test:e2e",
    "create-site": "node packages/create-site/bin/create-site.mjs",
    "release": "node scripts/release.mjs"
  }
}
